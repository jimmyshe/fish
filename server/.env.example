# 必填：PocketID 签发者地址
FISH_POCKETID_ISSUER=https://pocketid.ddoo.tech
# 必填：本 API 的 resource（期望的 aud）
FISH_API_RESOURCE=https://api.fishpet.ddoo.tech

# 可选：JWKS 端点，默认 {issuer}/.well-known/jwks.json
# FISH_JWKS_URL=
# 可选：OIDC userinfo 端点（建档时取用户名），默认 {issuer}/api/oidc/userinfo
# FISH_USERINFO_URL=
# 可选：要求的 scope，默认 fish:play
# FISH_REQUIRED_SCOPE=fish:play
# 可选：SQLite 数据库路径，默认 server/data/fish.db
# FISH_DB_PATH=server/data/fish.db
# 可选：每玩家每分钟事件上限，默认 30
# FISH_RATE_LIMIT_PER_MINUTE=30
